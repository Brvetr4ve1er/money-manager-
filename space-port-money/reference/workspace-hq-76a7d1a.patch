diff --git a/dashboard-v5/src/logic/money.js b/dashboard-v5/src/logic/money.js
new file mode 100644
index 0000000..443881b
--- /dev/null
+++ b/dashboard-v5/src/logic/money.js
@@ -0,0 +1,121 @@
+// Money actions (space "money", ported from Ember). Component.prototype mixin (src/app.js):
+// same `this` as the class methods.
+//
+//  - Every write is one INTENT to main (hq.money.apply via store.applyMoney): the renderer never
+//    builds entities, ids or timestamps — main validates and refuses with owner-facing copy.
+//  - One write at a time: S.mny.busy is the double-submit guard; a failed write releases it and
+//    toasts main's real error; success toasts only after main answered with a fresh view.
+//  - Drafts (half-typed forms) live in S.mny only — a main-side window reload drops them, which is
+//    fine: nothing is saved until the owner presses the button, and saved data comes back from main.
+//  - Writes are NOT gated on the time machine: money is live data, not a scan (scrub.js exception line).
+import { FX } from './shared.js';
+
+// XP for finished money actions only — never for opening a form (game layer is optional, two-track:
+// it rewards keeping the books, not spending or balances)
+const XP = { log: 3, 'obligation-pay': 5, 'inbox-confirm': 3, 'payday-run': 5, 'account-save': 2 };
+
+export const moneyLogic = {
+  mnySet(patch) { this.setState((s) => ({ mny: Object.assign({}, s.mny, patch) })); },
+  mnyField(form, key, value) { this.setState((s) => { const m = Object.assign({}, s.mny); m[form] = Object.assign({}, m[form], { [key]: value }); return { mny: m }; }); },
+  // one inline form open per kind; opening replaces its draft
+  mnyOpen(form, draft) { this.mnySet({ [form]: Object.assign({}, draft), ask: null }); },
+  mnyClose(form) { this.mnySet({ [form]: null }); },
+  mnySlip(id, patch) { this.setState((s) => { const m = Object.assign({}, s.mny); m.slip = Object.assign({}, m.slip, { [id]: Object.assign({}, (m.slip || {})[id], patch) }); return { mny: m }; }); },
+  mnySplit(jarId, value) { this.setState((s) => { const m = Object.assign({}, s.mny); m.split = Object.assign({}, m.split, { [jarId]: value }); return { mny: m }; }); },
+  // archive = an inline "are you sure" bar, not the run-confirm overlay
+  mnyAsk(type, payload, question) { this.mnySet({ ask: { type, payload, question } }); },
+  mnyAskYes() { const a = (this.state.mny || {}).ask; if (!a) return; this.mnySet({ ask: null }); this.mnyApply(Object.assign({ type: a.type }, a.payload)); },
+  mnyAskNo() { this.mnySet({ ask: null }); },
+
+  // the one write path. Resolves true when main saved it, false otherwise (already toasted).
+  async mnyApply(intent, after) {
+    const m = this.hq && this.hq.money;
+    if (!m) { this.denied('Unavailable — money needs the desktop bridge'); return false; }
+    if ((this.state.mny || {}).busy) return false;
+    this.mnySet({ busy: true });
+    let r;
+    try { r = await this.store.applyMoney(intent); }
+    catch (e) { r = { error: (e && e.message) || String(e) }; }
+    if (!r || r.error) {
+      this.mnySet({ busy: false });
+      this.toast('error', (r && r.error) || 'That didn’t save');
+      FX().sfx('error');
+      return false;
+    }
+    this.setState((s) => { const n = Object.assign({}, s.mny, { busy: false, note: r.note || '' }); if (after) after(n); return { mny: n }; });
+    if (r.note) this.toast('success', r.note);
+    if (XP[intent.type] && this.hq.actedOn) { try { this.hq.actedOn({ kind: 'money', action: intent.type, xp: XP[intent.type] }); } catch (e) { /* xp is a bonus, never a failure */ } }
+    FX().sfx('done');
+    return true;
+  },
+
+  mnySaveAccount() {
+    const f = (this.state.mny || {}).acct; if (!f) return;
+    this.mnyApply({ type: 'account-save', id: f.id, name: f.name, currency: f.currency || 'DA', balance: f.balance }, (n) => { n.acct = null; });
+  },
+  mnySaveSettings() {
+    const d = this.state.mny || {}, f = d.set || {}, V = (this.LIVE.money || {}).view;
+    const fx = f.fx != null ? f.fx : V ? V.settings.fx : '', pd = f.payday != null ? f.payday : V ? V.settings.payday : '';
+    this.mnyApply({ type: 'settings', fxDaPerUsd: fx, paydayDay: pd }, (n) => { n.set = null; });
+  },
+  mnyLog() {
+    const f = (this.state.mny || {}).log || {}, V = (this.LIVE.money || {}).view;
+    const accountId = f.accountId != null ? f.accountId : V && V.accounts[0] ? V.accounts[0].id : '';
+    // keep currency/category/account for the next entry (the daily coffee is two taps), clear amount + note
+    this.mnyApply({ type: 'log', amount: f.amount || '', currency: f.currency || 'DA', category: f.category || 'Food', accountId, note: f.note || '' }, (n) => { n.log = Object.assign({}, f, { amount: '', note: '', accountId }); });
+  },
+  mnySaveBill() {
+    const f = (this.state.mny || {}).bill; if (!f) return;
+    this.mnyApply(Object.assign({ type: 'obligation-save' }, f), (n) => { n.bill = null; });
+  },
+  mnyPay() {
+    const f = (this.state.mny || {}).pay; if (!f) return;
+    this.mnyApply({ type: 'obligation-pay', id: f.id, amount: f.amount || '', accountId: f.accountId || '' }, (n) => { n.pay = null; });
+  },
+  mnySaveJar() {
+    const f = (this.state.mny || {}).jar; if (!f) return;
+    this.mnyApply({ type: 'jar-save', id: f.id, name: f.name, target: f.target, targetDate: f.targetDate }, (n) => { n.jar = null; });
+  },
+  mnyMove() {
+    const f = (this.state.mny || {}).move; if (!f) return;
+    this.mnyApply({ type: 'jar-move', jarId: f.jarId, kind: f.kind, amount: f.amount }, (n) => { n.move = null; });
+  },
+  mnyCover() {
+    const f = (this.state.mny || {}).cover; if (!f) return;
+    if (!f.fromJarId) { this.toast('error', 'Pick a jar to cover from'); return; }
+    this.mnyApply({ type: 'jar-cover', fromJarId: f.fromJarId, toJarId: f.toJarId, amount: f.amount }, (n) => { n.cover = null; });
+  },
+  mnySaveSplit() {
+    const V = (this.LIVE.money || {}).view; if (!V) return;
+    const d = (this.state.mny || {}).split || {};
+    const rows = V.jars.map((j) => ({ jarId: j.id, amount: d[j.id] != null ? d[j.id] : j.split ? String(j.split) : '' }));
+    this.mnyApply({ type: 'split-save', rows }, (n) => { n.split = null; });
+  },
+  mnyPaydayRun() {
+    const f = (this.state.mny || {}).payday; if (!f) return;
+    this.mnyApply({ type: 'payday-run', accountId: f.accountId, amount: f.amount }, (n) => { n.payday = null; });
+  },
+  mnyPaste() {
+    const f = (this.state.mny || {}).paste || {};
+    this.mnyApply({ type: 'inbox-paste', text: f.text || '', from: f.from || '' }, (n) => { n.paste = { text: '', from: f.from || '' }; });
+  },
+  // promos / renewal notices / already-logged need a second, deliberate tap (main enforces it too)
+  mnyConfirmSlip(c, category, accountId) {
+    const d = this.state.mny || {};
+    if (c.warn && !(d.armed && d.armed[c.id])) { this.mnySet({ armed: Object.assign({}, d.armed, { [c.id]: true }) }); return; }
+    this.mnyApply({ type: 'inbox-confirm', id: c.id, category, accountId, anyway: !!c.warn }, (n) => { if (n.armed) delete n.armed[c.id]; if (n.slip) delete n.slip[c.id]; });
+  },
+
+  async mnyImport() {
+    const m = this.hq && this.hq.money;
+    if (!m || !m.importFile) return this.denied('Unavailable — money needs the desktop bridge');
+    const r = await this.call(() => this.store.importMoney(), 'Import failed');
+    if (r && !r.canceled && r.note) { this.toast('success', r.note); FX().sfx('done'); }
+  },
+  async mnyExport() {
+    const m = this.hq && this.hq.money;
+    if (!m || !m.exportFile) return this.denied('Unavailable — money needs the desktop bridge');
+    const r = await this.call(() => m.exportFile(), 'Export failed');
+    if (r && !r.canceled && r.note) this.toast('success', r.note);
+  },
+};
diff --git a/dashboard-v5/src/logic/money.test.mjs b/dashboard-v5/src/logic/money.test.mjs
new file mode 100644
index 0000000..257c7d0
--- /dev/null
+++ b/dashboard-v5/src/logic/money.test.mjs
@@ -0,0 +1,119 @@
+// Money space, renderer side: vals/money.js + logic/money.js on a rigged component (no DOM, no main).
+// LANDS AT dashboard-v5/src/logic/money.test.mjs — the imports below are written for that location.
+// Pins: honest load states (offline / error / loading / ready), keys all mny-prefixed, the double-submit
+// guard, real errors toasted + guard released, success toast only after main answered, intents carry
+// only form fields (no ids/timestamps minted here), and the second deliberate tap on flagged slips.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { moneyLogic } from './money.js';
+import { moneyVals } from '../vals/money.js';
+
+// FX() (logic/shared.js) reads window.HQFx; node has no window — give it a silent one
+globalThis.window = globalThis.window || { HQFx: { sfx() {} } };
+
+// the fake preload's fixture: the real ported engine's output on placeholder data
+const MONEY = JSON.parse(fs.readFileSync(new URL('../../tools/money.fake-views.json', import.meta.url), 'utf8'));
+
+function rig(o = {}) {
+  const calls = [], toasts = [];
+  const self = Object.assign(Object.create(moneyLogic), {
+    state: { mny: {}, ...(o.state || {}) },
+    setState(p) { this.state = { ...this.state, ...(typeof p === 'function' ? p(this.state) : p) }; },
+    toast: (k, t) => toasts.push([k, t]), denied(why) { toasts.push(['denied', why]); },
+    async call(fn, fail) { const r = await fn(); if (r && r.error) { toasts.push(['error', fail + ' · ' + r.error]); return null; } return r; },
+    LIVE: { money: o.money === undefined ? { view: MONEY.full, error: '', loaded: true } : o.money },
+    hq: o.noBridge ? null : { money: { read() {}, apply() {}, importFile() {}, exportFile: async () => ({ canceled: true }) }, actedOn: (x) => calls.push(['xp', x]) },
+    store: {
+      refreshMoney: () => calls.push(['refresh']),
+      applyMoney: async (intent) => { calls.push(['apply', intent]); return o.apply ? o.apply(intent) : { view: MONEY.full, note: 'saved' }; },
+      importMoney: async () => ({ canceled: true }),
+    },
+  });
+  const ctx = (sub = 'today', live = true) => ({ S: self.state, LIVE: self.LIVE, sub, live, tabStyle: (a) => ({ on: a }) });
+  const vals = (sub, live) => moneyVals.call(self, ctx(sub, live));
+  return { self, calls, toasts, vals };
+}
+
+test('every key is mny-prefixed (one shared namespace with the other surfaces)', () => {
+  const { vals } = rig();
+  for (const sub of ['today', 'runway', 'jars', 'inbox']) for (const k of Object.keys(vals(sub))) assert.match(k, /^(mny|onMny)[A-Z]/, k);
+});
+
+test('load states are honest and exclusive: offline · error · loading · ready', () => {
+  const pick = (v) => ['mnyOffline', 'mnyError', 'mnyLoading', 'mnyReady'].filter((k) => v[k]);
+  assert.deepEqual(pick(rig({ noBridge: true }).vals()), ['mnyOffline']);
+  assert.deepEqual(pick(rig({ money: { view: null, error: 'disk full', loaded: true } }).vals()), ['mnyError']);
+  assert.deepEqual(pick(rig({ money: { view: null, error: '', loaded: false } }).vals()), ['mnyLoading']);
+  assert.deepEqual(pick(rig().vals()), ['mnyReady']);
+  assert.equal(rig({ money: { view: MONEY.empty, error: '', loaded: true } }).vals().mnyNoAccounts, true);
+});
+
+test('time machine: money says it stays live when scrubbed', () => {
+  assert.equal(rig().vals('today', false).mnyScrubbed, true);
+  assert.equal(rig().vals('today', true).mnyScrubbed, false);
+});
+
+test('log sends only the form fields; keeps currency/category/account, clears amount + note; xp after success', async () => {
+  const { self, calls, toasts } = rig();
+  self.mnyField('log', 'amount', '350'); self.mnyField('log', 'category', 'Food'); self.mnyField('log', 'note', 'bread');
+  await self.mnyLog();
+  const [, intent] = calls.find((c) => c[0] === 'apply');
+  assert.deepEqual(Object.keys(intent).sort(), ['accountId', 'amount', 'category', 'currency', 'note', 'type']);
+  assert.equal(intent.accountId, MONEY.full.accounts[0].id);
+  assert.deepEqual([self.state.mny.log.amount, self.state.mny.log.note, self.state.mny.log.category], ['', '', 'Food']);
+  assert.deepEqual(toasts, [['success', 'saved']]);
+  assert.ok(calls.some((c) => c[0] === 'xp'));
+  assert.equal(self.state.mny.busy, false);
+});
+
+test('a refused write toasts main’s real error, releases the guard, keeps the draft, no xp', async () => {
+  const { self, calls, toasts } = rig({ apply: () => ({ error: 'amount needs a number above 0.' }) });
+  self.mnyField('log', 'amount', 'abc');
+  assert.equal(await self.mnyApply({ type: 'log', amount: 'abc' }), false);
+  assert.deepEqual(toasts, [['error', 'amount needs a number above 0.']]);
+  assert.equal(self.state.mny.busy, false);
+  assert.equal(self.state.mny.log.amount, 'abc');
+  assert.ok(!calls.some((c) => c[0] === 'xp'));
+});
+
+test('double submit: a second write while one is in flight sends nothing', async () => {
+  let release; const { self, calls } = rig({ apply: () => new Promise((r) => { release = () => r({ view: MONEY.full, note: 'ok' }); }) });
+  const first = self.mnyApply({ type: 'inbox-clear' });
+  assert.equal(await self.mnyApply({ type: 'inbox-clear' }), false);
+  release(); await first;
+  assert.equal(calls.filter((c) => c[0] === 'apply').length, 1);
+});
+
+test('no bridge: writes are denied with the reason, nothing sent', async () => {
+  const { self, toasts } = rig({ noBridge: true });
+  assert.equal(await self.mnyApply({ type: 'inbox-clear' }), false);
+  assert.match(toasts[0][1], /desktop bridge/);
+});
+
+test('a flagged slip (promo) needs a second deliberate tap, then sends anyway:true', async () => {
+  const { self, calls, vals } = rig();
+  const promo = vals('inbox').mnySlips.find((c) => c.warn);
+  assert.ok(promo, 'fixture has a promo slip');
+  promo.confirm();
+  assert.equal(calls.filter((c) => c[0] === 'apply').length, 0);
+  const armed = vals('inbox').mnySlips.find((c) => c.id === promo.id);
+  assert.equal(armed.confirmLabel, 'Confirm anyway');
+  assert.match(armed.warnLine, /promotion/);
+  await armed.confirm();
+  const [, intent] = calls.find((c) => c[0] === 'apply');
+  assert.deepEqual([intent.type, intent.id, intent.anyway], ['inbox-confirm', promo.id, true]);
+});
+
+test('archive asks inline first; Keep it sends nothing, Archive sends the intent', async () => {
+  const { self, calls, vals } = rig();
+  vals('runway').mnyObligations[0].archive();
+  assert.match(vals('runway').mnyAskText, /^Archive /);
+  self.mnyAskNo();
+  assert.equal(vals('runway').mnyHasAsk, false);
+  vals('runway').mnyObligations[0].archive();
+  self.mnyAskYes();
+  await new Promise((r) => setTimeout(r, 0));
