diff --git a/dashboard/money/inbox.mjs b/dashboard/money/inbox.mjs
new file mode 100644
index 0000000..b25c964
--- /dev/null
+++ b/dashboard/money/inbox.mjs
@@ -0,0 +1,167 @@
+/**
+ * Inbox slice — the review tray. Parsed candidates land here as `pending`
+ * and stay claims until the user confirms (a ledger row is created by the
+ * root LOG_TX, and its id recorded here) or rejects them. Nothing in this
+ * slice ever writes to the ledger on its own.
+ *
+ * Merge rules (local-first, symmetric):
+ * - Candidates are entities keyed by id; the newer `updatedAt` wins.
+ * - Status never regresses: a resolved copy (confirmed/rejected) beats a
+ *   pending one whatever the timestamps, and a cleared copy beats both, so a
+ *   stale tab can never put a handled slip back in the tray.
+ * - "Clear handled" is a tombstone (`cleared`, sources dropped), never a
+ *   removal — a peer still holding the row can't resurrect it.
+ * - `alreadyLogged` is derived from the ledger at render time, never stored.
+ */
+import { isIsoDatetime, isValidDayKey } from './dates.mjs';
+import { isSamePurchase, mergeCandidate } from './dedupe.mjs';
+import { INBOX_FLAGS } from './parse.mjs';
+export function defaultInbox() {
+    return { candidates: [] };
+}
+/* ------------------------------ sanitize ------------------------------ */
+function isRecord(v) {
+    return typeof v === 'object' && v !== null;
+}
+const isStr = (v) => typeof v === 'string';
+const isNum = (v) => typeof v === 'number' && Number.isFinite(v);
+const STATUSES = ['pending', 'confirmed', 'rejected'];
+function sanitizeSource(v) {
+    if (!isRecord(v) || !isStr(v.from) || !isStr(v.text))
+        return null;
+    return { from: v.from, text: v.text, receivedAt: isIsoDatetime(v.receivedAt) ? v.receivedAt : '' };
+}
+function sanitizeCandidate(v) {
+    if (!isRecord(v) || !isStr(v.id) || v.id === '' || !isStr(v.merchant) || !isNum(v.amount))
+        return null;
+    if (v.currency !== 'DA' && v.currency !== 'USD')
+        return null;
+    if (!isValidDayKey(v.date) || !isNum(v.confidence) || !isIsoDatetime(v.updatedAt))
+        return null;
+    if (!STATUSES.includes(v.status))
+        return null;
+    const cleared = v.cleared === true;
+    const status = v.status;
+    // Only a handled slip can be cleared; a pending one must keep its evidence.
+    if (cleared && status === 'pending')
+        return null;
+    const sources = [];
+    if (!cleared && Array.isArray(v.sources)) {
+        for (const s of v.sources) {
+            const ok = sanitizeSource(s);
+            if (ok && !sources.some((x) => x.text === ok.text))
+                sources.push(ok);
+        }
+    }
+    if (!cleared && sources.length === 0)
+        return null;
+    const flags = Array.isArray(v.flags) ? INBOX_FLAGS.filter((f) => v.flags.includes(f)) : [];
+    return {
+        id: v.id,
+        merchant: v.merchant,
+        amount: v.amount,
+        currency: v.currency,
+        date: v.date,
+        sources,
+        confidence: Math.min(1, Math.max(0, v.confidence)),
+        flags,
+        suggestedCategory: isStr(v.suggestedCategory) ? v.suggestedCategory : 'Other',
+        status,
+        txId: status === 'confirmed' && isStr(v.txId) ? v.txId : null,
+        cleared,
+        updatedAt: v.updatedAt,
+    };
+}
+const rank = (c) => (c.cleared ? 2 : c.status === 'pending' ? 0 : 1);
+/** Status rank first (never regress), then newer instant, then greater JSON. */
+function winner(a, b) {
+    if (rank(a) !== rank(b))
+        return rank(a) > rank(b) ? a : b;
+    const ta = Date.parse(a.updatedAt);
+    const tb = Date.parse(b.updatedAt);
+    if (ta !== tb)
+        return ta > tb ? a : b;
+    return JSON.stringify(a) >= JSON.stringify(b) ? a : b;
+}
+function mergeEntities(xs) {
+    const m = new Map();
+    for (const x of xs) {
+        const prev = m.get(x.id);
+        m.set(x.id, prev ? winner(prev, x) : x);
+    }
+    return [...m.values()].sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+}
+export function sanitizeInbox(v) {
+    const out = defaultInbox();
+    if (!isRecord(v) || !Array.isArray(v.candidates))
+        return out;
+    const rows = [];
+    for (const x of v.candidates) {
+        const c = sanitizeCandidate(x);
+        if (c)
+            rows.push(c);
+    }
+    out.candidates = mergeEntities(rows);
+    return out;
+}
+/** Symmetric cross-tab merge; output in defaultInbox() key order. */
+export function mergeInbox(a, b) {
+    return { candidates: mergeEntities([...a.candidates, ...b.candidates]) };
+}
+/**
+ * Fold incoming candidates into the tray: each one that is the same purchase
+ * as a pending slip (see isSamePurchase) joins that slip as another source;
+ * the rest become new pending slips. Exposed so the paste card can report
+ * exactly what `inbox/add` will do.
+ */
+export function planAdd(s, incoming, nowISO) {
+    if (!isIsoDatetime(nowISO))
+        return { state: s, added: 0, merged: 0 };
+    const rows = [...s.candidates];
+    const ids = new Set(rows.map((r) => r.id));
+    let added = 0;
+    let merged = 0;
+    for (const raw of incoming) {
+        const c = sanitizeCandidate({ ...raw, status: 'pending', txId: null, cleared: false, updatedAt: nowISO });
+        if (!c || ids.has(c.id))
+            continue;
+        const i = rows.findIndex((r) => r.status === 'pending' && !r.cleared && isSamePurchase(r, c));
+        if (i === -1) {
+            rows.push(c);
+            ids.add(c.id);
+            added++;
+        }
+        else {
+            rows[i] = { ...mergeCandidate(rows[i], c), updatedAt: nowISO };
+            merged++;
+        }
+    }
+    if (added === 0 && merged === 0)
+        return { state: s, added, merged };
+    return { state: { candidates: mergeEntities(rows) }, added, merged };
+}
+export function inboxReducer(s, a) {
+    switch (a.type) {
+        case 'inbox/add':
+            return planAdd(s, a.candidates, a.nowISO).state;
+        case 'inbox/resolve': {
+            const c = s.candidates.find((x) => x.id === a.id);
+            if (!c || c.status !== 'pending' || !isIsoDatetime(a.nowISO))
+                return s;
+            const next = {
+                ...c,
+                status: a.status,
+                txId: a.status === 'confirmed' ? a.txId : null,
+                updatedAt: a.nowISO,
+            };
+            return { candidates: mergeEntities([...s.candidates.filter((x) => x.id !== a.id), next]) };
+        }
+        case 'inbox/clear-resolved': {
+            if (!isIsoDatetime(a.nowISO) || !s.candidates.some((c) => c.status !== 'pending' && !c.cleared))
+                return s;
+            return {
+                candidates: s.candidates.map((c) => c.status !== 'pending' && !c.cleared ? { ...c, sources: [], cleared: true, updatedAt: a.nowISO } : c),
+            };
+        }
+    }
+}
diff --git a/dashboard/money/inbox.test.mjs b/dashboard/money/inbox.test.mjs
new file mode 100644
index 0000000..e9841ca
--- /dev/null
+++ b/dashboard/money/inbox.test.mjs
@@ -0,0 +1,126 @@
+// Ported verbatim from Ember src/state/slices/inbox.test.ts (types stripped; vitest -> vitest-shim.mjs on node:test).
+import { describe, it, expect } from './vitest-shim.mjs';
+import { defaultInbox, inboxReducer, mergeInbox, planAdd, sanitizeInbox } from './inbox.mjs';
+const T1 = '2026-10-01T08:00:00.000Z';
+const T2 = '2026-10-02T08:00:00.000Z';
+const T3 = '2026-10-03T08:00:00.000Z';
+const cand = (over = {}) => ({
+    id: 'c1',
+    merchant: 'Steam',
+    amount: 12.49,
+    currency: 'USD',
+    date: '2026-10-08',
+    sources: [{ from: 'no-reply@redotpay.com', text: 'Card transaction: USD 12.49 at STEAMGAMES.COM', receivedAt: T1 }],
+    confidence: 0.9,
+    flags: [],
+    suggestedCategory: 'Fun',
+    status: 'pending',
+    txId: null,
+    cleared: false,
+    updatedAt: T1,
+    ...over,
+});
+const state = (...cs) => ({ candidates: cs });
+describe('sanitizeInbox', () => {
+    it('returns the default for junk', () => {
+        expect(sanitizeInbox(null)).toEqual(defaultInbox());
+        expect(sanitizeInbox({ candidates: 'x' })).toEqual(defaultInbox());
+    });
+    it('keeps valid rows field by field and drops malformed ones', () => {
+        const out = sanitizeInbox({
+            candidates: [
+                cand(),
+                cand({ id: 'bad-amt', amount: NaN }),
+                cand({ id: 'bad-cur', currency: 'EUR' }),
+                cand({ id: 'bad-date', date: '2026-02-30' }),
+                cand({ id: 'no-src', sources: [] }),
+                cand({ id: 'bad-status', status: 'maybe' }),
+                { ...cand({ id: 'extra' }), evil: 1, flags: ['promo', 'nope', 'promo'], confidence: 7 },
+            ],
+        });
+        expect(out.candidates.map((c) => c.id)).toEqual(['c1', 'extra']);
+        const extra = out.candidates[1];
+        expect('evil' in extra).toBe(false);
+        expect(extra.flags).toEqual(['promo']);
+        expect(extra.confidence).toBe(1);
+    });
+    it('never keeps a txId on a non-confirmed row and rejects a cleared pending row', () => {
+        const out = sanitizeInbox({ candidates: [cand({ txId: 'tx' }), cand({ id: 'c2', status: 'pending', cleared: true, sources: [] })] });
+        expect(out.candidates).toHaveLength(1);
+        expect(out.candidates[0].txId).toBeNull();
+    });
+    it('is a merge fixpoint (duplicates collapse)', () => {
+        const s = sanitizeInbox({ candidates: [cand(), cand({ updatedAt: T2, merchant: 'Steam 2' })] });
+        expect(s.candidates).toHaveLength(1);
+        expect(JSON.stringify(mergeInbox(s, s))).toBe(JSON.stringify(s));
+        expect(JSON.stringify(sanitizeInbox(JSON.parse(JSON.stringify(s))))).toBe(JSON.stringify(s));
+    });
+});
+describe('mergeInbox', () => {
+    it('newer updatedAt wins, compared as instants', () => {
+        const a = state(cand({ merchant: 'A', updatedAt: '2026-10-02T08:00:00Z' }));
+        const b = state(cand({ merchant: 'B', updatedAt: '2026-10-01T08:00:00.500Z' }));
+        expect(mergeInbox(a, b).candidates[0].merchant).toBe('A');
+        expect(mergeInbox(b, a).candidates[0].merchant).toBe('A');
+    });
+    it('status never regresses from confirmed/rejected to pending', () => {
+        const resolved = state(cand({ status: 'confirmed', txId: 'tx1', updatedAt: T1 }));
+        const pendingNewer = state(cand({ updatedAt: T3 }));
+        expect(mergeInbox(resolved, pendingNewer).candidates[0].status).toBe('confirmed');
+        expect(mergeInbox(pendingNewer, resolved).candidates[0].status).toBe('confirmed');
+    });
+    it('a cleared tombstone is never resurrected', () => {
+        const cleared = state(cand({ status: 'rejected', cleared: true, sources: [], updatedAt: T1 }));
+        const stale = state(cand({ status: 'rejected', updatedAt: T3 }));
+        expect(mergeInbox(stale, cleared).candidates[0].cleared).toBe(true);
+    });
+    it('is symmetric and unions ids', () => {
+        const a = state(cand(), cand({ id: 'c3', merchant: 'Jumia', amount: 5600, currency: 'DA' }));
+        const b = state(cand({ id: 'c2', merchant: 'Yassir', amount: 650, currency: 'DA' }));
+        expect(JSON.stringify(mergeInbox(a, b))).toBe(JSON.stringify(mergeInbox(b, a)));
+        expect(mergeInbox(a, b).candidates.map((c) => c.id)).toEqual(['c1', 'c2', 'c3']);
+    });
+});
+describe('inboxReducer', () => {
+    it('inbox/add appends pending slips and dedupes against pending ones', () => {
+        let s = inboxReducer(defaultInbox(), { type: 'inbox/add', candidates: [cand()], nowISO: T1 });
+        expect(s.candidates).toHaveLength(1);
+        s = inboxReducer(s, {
+            type: 'inbox/add',
+            candidates: [cand({ id: 'c2', merchant: 'Steam', sources: [{ from: 'noreply@steampowered.com', text: 'Steam receipt Total $12.49', receivedAt: T2 }] })],
+            nowISO: T2,
+        });
+        expect(s.candidates).toHaveLength(1);
+        expect(s.candidates[0].sources).toHaveLength(2);
+        expect(s.candidates[0].flags).toContain('duplicate');
+        expect(s.candidates[0].updatedAt).toBe(T2);
+    });
+    it('inbox/add does not merge into a resolved slip, and forces pending status', () => {
+        const s = state(cand({ status: 'rejected' }));
+        const out = inboxReducer(s, { type: 'inbox/add', candidates: [cand({ id: 'c2', status: 'confirmed' })], nowISO: T2 });
+        expect(out.candidates).toHaveLength(2);
+        expect(out.candidates[1].status).toBe('pending');
+    });
+    it('planAdd reports added and merged counts; bad stamps are no-ops', () => {
+        const p = planAdd(defaultInbox(), [cand(), cand({ id: 'c2', sources: [{ from: 'x', text: 'other', receivedAt: '' }] })], T1);
+        expect([p.added, p.merged]).toEqual([1, 1]);
+        const s = defaultInbox();
+        expect(inboxReducer(s, { type: 'inbox/add', candidates: [cand()], nowISO: 'nope' })).toBe(s);
+    });
+    it('inbox/resolve confirms with a txId or rejects, only from pending', () => {
+        const s = state(cand());
+        const ok = inboxReducer(s, { type: 'inbox/resolve', id: 'c1', status: 'confirmed', txId: 'tx1', nowISO: T2 });
+        expect(ok.candidates[0]).toMatchObject({ status: 'confirmed', txId: 'tx1', updatedAt: T2 });
+        expect(inboxReducer(ok, { type: 'inbox/resolve', id: 'c1', status: 'rejected', txId: null, nowISO: T3 })).toBe(ok);
+        const rej = inboxReducer(s, { type: 'inbox/resolve', id: 'c1', status: 'rejected', txId: 'ignored', nowISO: T2 });
+        expect(rej.candidates[0]).toMatchObject({ status: 'rejected', txId: null });
+    });
+    it('inbox/clear-resolved tombstones handled slips and drops their text', () => {
+        const s = state(cand({ status: 'confirmed', txId: 'tx1' }), cand({ id: 'c2' }));
+        const out = inboxReducer(s, { type: 'inbox/clear-resolved', nowISO: T2 });
+        expect(out.candidates[0]).toMatchObject({ cleared: true, sources: [] });
+        expect(out.candidates[1].cleared).toBe(false);
+        expect(sanitizeInbox(JSON.parse(JSON.stringify(out)))).toEqual(out);
+        expect(inboxReducer(out, { type: 'inbox/clear-resolved', nowISO: T3 })).toBe(out);
+    });
+});
