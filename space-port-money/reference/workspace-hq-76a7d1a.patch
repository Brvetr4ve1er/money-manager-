+        expect(splitMessages('Paid 300 DA at A\n---\nPaid 400 DA at B')).toHaveLength(2);
+        expect(splitMessages('Paid 300 DA at A\n\nPaid 400 DA at B')).toHaveLength(2);
+    });
+    it('keeps an email with paragraphs as one message', () => {
