index 0000000..9fa2dc6
--- /dev/null
+++ b/dashboard/money.js
@@ -0,0 +1,132 @@
+// money space — main side. Owner money data lives in <dataDir>/money/state.json (gitignored).
+// IPC-CONTRACT rows: hq:money:read · hq:money:apply · hq:money:import · hq:money:export.
+// The domain logic is Ember's, ported to ESM in ./money/*.mjs and reached through import()
+// (Electron 32 cannot require ESM — same idiom as claude-prompts.js / claude-imports.js).
+//
+// init({ ipcMain, dataDir, getWin }) → { read, apply }   (read/apply exported for tests + MCP later)
+// - the renderer sends INTENTS, never entities; commands.mjs validates every field and mints
+//   ids/timestamps here. Unknown intent types are refused before any IO.
+// - every handler resolves { view, note? } or { error } — never throws at the renderer.
+// - writes are synchronous tmp + rename inside one handler tick, so two applies serialize on the
+//   event loop and a crash mid-write leaves the previous file intact.
+// - a corrupt state.json is quarantined to state.json.corrupt (readJsonStore idiom), never overwritten.
+// - NO window reload after a write: the reply carries the fresh view, the renderer swaps it in.
+// - no network, nothing outbound. import/export only touch a file the owner picked in a native dialog.
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+const { pathToFileURL } = require('url');
+
+const MAX_IMPORT_BYTES = 5 * 1024 * 1024;
+const MAX_INTENT_BYTES = 64 * 1024;
+let libs = null;   // { store, commands, view } once loaded
+async function lib() {
+  if (!libs) {
+    const load = (f) => import(pathToFileURL(path.join(__dirname, 'money', f)).href);
+    const [store, commands, view] = await Promise.all([load('store.mjs'), load('commands.mjs'), load('view.mjs')]);
+    libs = { store, commands, view };
+  }
+  return libs;
+}
+
+function create({ dataDir, now = () => new Date(), newId = () => crypto.randomUUID(), pick = null }) {
+  const dir = path.join(dataDir, 'money'), file = path.join(dir, 'state.json');
+
+  function readState(L) {
+    let raw;
+    try { raw = fs.readFileSync(file, 'utf8'); }
+    catch (e) { if (e.code === 'ENOENT') return L.store.defaultState(); throw e; }
+    try { return L.store.sanitizeState(JSON.parse(raw)); }
+    catch (e) {
+      try { fs.renameSync(file, file + '.corrupt'); } catch { /* best effort — never throw from a read */ }
+      console.error(`[money] corrupt state.json quarantined to state.json.corrupt — ${e.message}`);
+      return L.store.defaultState();
+    }
+  }
+  function writeState(state) {
+    fs.mkdirSync(dir, { recursive: true });
+    const tmp = file + '.' + process.pid + '.tmp';
+    fs.writeFileSync(tmp, JSON.stringify(state, null, 1));
+    fs.renameSync(tmp, file);
+  }
+  const reply = (L, state, note) => ({ view: L.view.buildView(state, now()), ...(note ? { note } : {}) });
+
+  async function read() {
+    const L = await lib();
+    try { return reply(L, readState(L)); }
+    catch (e) { return { error: 'could not read money data — ' + e.message }; }
+  }
+
+  async function apply(intent) {
+    const L = await lib();
+    // cheap checks before any IO: shape, size, allowlisted type
+    if (!intent || typeof intent !== 'object' || Array.isArray(intent)) return { error: 'unknown action.' };
+    let size = 0; try { size = JSON.stringify(intent).length; } catch { return { error: 'unknown action.' }; }
+    if (size > MAX_INTENT_BYTES || !L.commands.INTENTS.includes(intent.type)) return { error: 'unknown action.' };
+    let state;
+    try { state = readState(L); } catch (e) { return { error: 'could not read money data — ' + e.message }; }
+    let r;
+    try { r = L.commands.apply(state, intent, { now: now(), newId }); }
+    catch (e) { return { error: e instanceof L.commands.MoneyError ? e.message : 'that did not work — ' + e.message }; }
+    try { writeState(r.state); } catch (e) { return { error: 'not saved — could not write money data: ' + e.message }; }
+    return reply(L, r.state, r.note);
+  }
+
+  async function importFile() {
+    const L = await lib();
+    let f; try { f = pick ? await pick('open') : null; } catch { return { error: 'could not open the file dialog' }; }
+    if (!f) return { canceled: true };
+    let raw;
+    try {
+      if (fs.statSync(f).size > MAX_IMPORT_BYTES) return { error: 'that file is too big to be an Ember export.' };
+      raw = JSON.parse(fs.readFileSync(f, 'utf8'));
+    } catch { return { error: 'that file is not an Ember export (could not read it as JSON).' }; }
+    const incoming = L.store.sanitizeState(raw);
+    const found = incoming.transactions.length + incoming.money.accounts.length + incoming.money.obligations.length + incoming.money.jars.length;
+    if (!found) return { error: 'nothing to import — no accounts, bills, jars or entries in that file.' };
+    let state; try { state = readState(L); } catch (e) { return { error: 'could not read money data — ' + e.message }; }
+    const merged = L.store.mergeState(state, incoming);
+    try { writeState(merged); } catch (e) { return { error: 'not imported — could not write money data: ' + e.message }; }
+    const added = merged.transactions.length - state.transactions.length;
+    return reply(L, merged, `imported from ${path.basename(f)} · ${added} new entr${added === 1 ? 'y' : 'ies'}`);
+  }
+
+  async function exportFile() {
+    const L = await lib();
+    let state; try { state = readState(L); } catch (e) { return { error: 'could not read money data — ' + e.message }; }
+    let f; try { f = pick ? await pick('save') : null; } catch { return { error: 'could not open the file dialog' }; }
+    if (!f) return { canceled: true };
+    try { fs.writeFileSync(f, JSON.stringify(state, null, 1)); } catch (e) { return { error: 'not exported — ' + e.message }; }
+    return { note: `exported to ${path.basename(f)}` };
+  }
+
+  return { read, apply, importFile, exportFile, file };
+}
+
+function dialogPicker(getWin) {
+  return async (mode) => {
+    const { dialog, app } = require('electron');
+    const win = getWin && getWin();
+    const filters = [{ name: 'Money data (.json)', extensions: ['json'] }];
+    if (mode === 'open') {
+      const opts = { title: 'Import money data (an Ember export or a money export)', properties: ['openFile'], filters };
+      const r = win ? await dialog.showOpenDialog(win, opts) : await dialog.showOpenDialog(opts);
+      return r && !r.canceled && r.filePaths && r.filePaths[0] ? r.filePaths[0] : null;
+    }
+    const opts = { title: 'Export money data', defaultPath: path.join(app.getPath('documents'), `money-${new Date().toISOString().slice(0, 10)}.json`), filters };
+    const r = win ? await dialog.showSaveDialog(win, opts) : await dialog.showSaveDialog(opts);
+    return r && !r.canceled && r.filePath ? r.filePath : null;
+  };
+}
+
+function init({ ipcMain, dataDir, getWin }) {
+  const gateFile = process.env.HQ_MONEY_IMPORT_FILE;   // gates only: no dialog in a hidden second instance
+  const m = create({ dataDir, pick: gateFile ? async (mode) => (mode === 'open' ? gateFile : null) : dialogPicker(getWin) });
+  ipcMain.handle('hq:money:read', () => m.read());
+  ipcMain.handle('hq:money:apply', (_e, intent) => m.apply(intent));
+  ipcMain.handle('hq:money:import', () => m.importFile());
+  ipcMain.handle('hq:money:export', () => m.exportFile());
+  return { read: m.read, apply: m.apply };
+}
+
+module.exports = { create, init };
diff --git a/dashboard/money.test.mjs b/dashboard/money.test.mjs
new file mode 100644
index 0000000..2f4fe7d
--- /dev/null
+++ b/dashboard/money.test.mjs
@@ -0,0 +1,137 @@
+// money space, main side. Pins: the four IPC channels, intent validation before IO,
+// atomic + corrupt-tolerant persistence, restart survival, import as a union (never a replace),
+// and that every failure comes back as { error } — the renderer is never thrown at.
+// Temp dirs only; the dialog is injected (no real file pickers, no network).
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const require = createRequire(import.meta.url);
+const money = require('./money.js');
+
+// a clock that moves a minute per call (real use never logs in the same ms as an anchor) + counted ids
+function boot({ dir, picks = [] } = {}) {
+  dir = dir || fs.mkdtempSync(path.join(os.tmpdir(), 'hq-money-'));
+  let t = Date.parse('2026-11-03T09:00:00Z'), n = 0;
+  const m = money.create({ dataDir: dir, now: () => new Date(t += 60000), newId: () => 'id' + (++n), pick: async (mode) => { const p = picks.shift(); assert.ok(p, `unexpected ${mode} dialog`); return p.file; } });
+  return { m, dir };
+}
+
+test('init registers exactly the four documented channels', () => {
+  const handlers = new Map();
+  const ipcMain = { handle: (ch, fn) => { assert.ok(!handlers.has(ch), `${ch} registered twice`); handlers.set(ch, fn); } };
+  money.init({ ipcMain, dataDir: fs.mkdtempSync(path.join(os.tmpdir(), 'hq-money-')), getWin: () => null });
+  assert.deepEqual([...handlers.keys()].sort(), ['hq:money:apply', 'hq:money:export', 'hq:money:import', 'hq:money:read']);
+});
+
+test('first read: no file is a correct empty state, nothing written', async () => {
+  const { m } = boot();
+  const r = await m.read();
+  assert.equal(r.view.hasAccounts, false);
+  assert.equal(r.view.room.has, false);
+  assert.equal(fs.existsSync(m.file), false);
+});
+
+test('account → bill → spend moves breathing room exactly; survives a restart', async () => {
+  const { m, dir } = boot();
+  assert.equal((await m.apply({ type: 'account-save', name: 'Cash', currency: 'DA', balance: '50 000' })).note, 'Cash added');
+  await m.apply({ type: 'obligation-save', name: 'Rent', amount: '18000', firstDue: '2026-11-20', accountId: 'id1' });
+  const r = await m.apply({ type: 'log', amount: '1 200', category: 'Food', accountId: 'id1' });
+  assert.equal(r.view.room.amount, '30,800 DA');
+  assert.equal(r.view.recent[0].category, 'Food');
+  const again = boot({ dir });   // same dataDir = an app restart
+  assert.equal((await again.m.read()).view.room.amount, '30,800 DA');
+});
+
+test('pay a bill writes a Bills row on the bill account; undo removes both', async () => {
+  const { m } = boot();
+  await m.apply({ type: 'account-save', name: 'Cash', currency: 'DA', balance: '50000' });
+  await m.apply({ type: 'obligation-save', name: 'Rent', amount: '18000', firstDue: '2026-11-20', accountId: 'id1' });
+  const paid = await m.apply({ type: 'obligation-pay', id: 'id2' });
+  assert.equal(paid.note, 'Rent paid');
+  assert.equal(paid.view.accounts[0].balance, '32,000 DA');
+  assert.equal(paid.view.recent[0].isBill, true);
+  const undoId = paid.view.obligations[0].undoId;
+  assert.ok(undoId);
+  const undone = await m.apply({ type: 'obligation-unpay', paymentId: undoId });
+  assert.equal(undone.view.accounts[0].balance, '50,000 DA');
+  assert.equal(undone.view.ledgerCount, 0);
+});
+
+test('refused intents come back as { error } and change nothing on disk', async () => {
+  const { m } = boot();
+  await m.apply({ type: 'account-save', name: 'Cash', currency: 'DA', balance: '100' });
+  const before = fs.readFileSync(m.file, 'utf8');
+  for (const bad of [null, [], 'log', { type: 'drop-table' }, { type: 'log', amount: '-5' }, { type: 'log', amount: 'abc' }, { type: 'log', amount: '10', currency: 'EUR' },
+    { type: 'log', amount: '10', currency: 'USD' }, { type: 'obligation-pay', id: '../../etc' }, { type: 'account-save', name: '', balance: '1' }, { type: 'inbox-paste', text: 'x'.repeat(70000) }]) {
+    const r = await m.apply(bad);
+    assert.equal(typeof r.error, 'string', JSON.stringify(bad));
+    assert.equal(r.view, undefined);
+  }
+  assert.equal(fs.readFileSync(m.file, 'utf8'), before);
+});
+
+test('a USD log is refused until the rate is set, then converts', async () => {
+  const { m } = boot();
+  assert.match((await m.apply({ type: 'log', amount: '12.49', currency: 'USD' })).error, /DA rate/);
+  await m.apply({ type: 'settings', fxDaPerUsd: '245', paydayDay: '25' });
+  const r = await m.apply({ type: 'log', amount: '12.49', currency: 'USD', category: 'Fun' });
+  assert.equal(r.view.recent[0].amount, '$12.49 · 3,060 DA');
+});
+
+test('corrupt state.json is quarantined, never overwritten', async () => {
+  const { m } = boot();
+  fs.mkdirSync(path.dirname(m.file), { recursive: true });
+  fs.writeFileSync(m.file, '{ not json');
+  const r = await m.read();
+  assert.equal(r.view.hasAccounts, false);
+  assert.equal(fs.readFileSync(m.file + '.corrupt', 'utf8'), '{ not json');
+});
+
+test('inbox: paste → one slip; promo needs a second deliberate tap; refund lands as income', async () => {
+  const { m } = boot();
+  await m.apply({ type: 'account-save', name: 'Card', currency: 'USD', balance: '100' });
+  await m.apply({ type: 'settings', fxDaPerUsd: '245', paydayDay: '' });
+  const p = await m.apply({ type: 'inbox-paste', text: 'Spotify: Get 3 months of Premium for $0. Offer ends 20 October.\n---\nYour refund has been processed. USD 12.49 will be returned to your card ending 0000.', from: 'noreply@steampowered.com' });
+  assert.match(p.note, /read 2 messages/);
+  const promo = p.view.slips.find((s) => s.warn), refund = p.view.slips.find((s) => s.refund);
+  assert.ok(promo && refund);
+  assert.match((await m.apply({ type: 'inbox-confirm', id: promo.id, category: 'Fun' })).error, /confirm anyway/);
+  assert.equal((await m.apply({ type: 'inbox-confirm', id: promo.id, category: 'Fun', anyway: true })).view.ledgerCount, 1);
+  const back = await m.apply({ type: 'inbox-confirm', id: refund.id, accountId: 'id1' });
+  assert.equal(back.view.accounts[0].balance, '$112.49');
+  assert.equal(back.view.ledgerCount, 1);   // a refund never becomes spending
+  assert.equal(back.view.handled, 2);
+  assert.equal((await m.apply({ type: 'inbox-clear' })).view.handled, 0);
+});
+
+test('import merges an Ember export as a union and reports it; export writes the state', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hq-money-io-'));
+  const ember = path.join(dir, 'ember-export.json');
+  const at = '2026-10-01T09:00:00.000Z';
+  fs.writeFileSync(ember, JSON.stringify({ profile: { ignored: true }, money: { accounts: [{ id: 'cash', name: 'Cash', currency: 'DA', anchorBalance: 20000, anchorAt: at, archived: false, updatedAt: at }] },
+    transactions: [{ id: 't1', amountDA: 500, category: 'Food', date: '2026-10-02', accountId: 'cash' }, { id: 'bad', amountDA: -1, category: 'x', date: '2026-10-02' }] }));
+  const out = path.join(dir, 'out.json');
+  const { m } = boot({ picks: [{ file: ember }, { file: ember }, { file: out }, { file: null }] });
+  const r = await m.importFile();
+  assert.match(r.note, /1 new entry/);
+  assert.equal(r.view.accounts[0].balance, '19,500 DA');
+  const twice = await m.importFile();   // same file again: union, nothing doubles
+  assert.match(twice.note, /0 new entries/);
+  assert.equal((await m.exportFile()).note, 'exported to out.json');
+  assert.equal(JSON.parse(fs.readFileSync(out, 'utf8')).transactions.length, 1);
+  assert.deepEqual(await m.exportFile(), { canceled: true });
+});
+
+test('import refuses a file that is not an export, writes nothing', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hq-money-io-'));
+  const junk = path.join(dir, 'junk.json'); fs.writeFileSync(junk, '{"hello":1}');
+  const txt = path.join(dir, 'notes.json'); fs.writeFileSync(txt, 'plain text');
+  const { m } = boot({ picks: [{ file: junk }, { file: txt }] });
+  assert.match((await m.importFile()).error, /nothing to import/);
+  assert.match((await m.importFile()).error, /not an Ember export/);
+  assert.equal(fs.existsSync(m.file), false);
+});
diff --git a/dashboard/money/commands.mjs b/dashboard/money/commands.mjs
new file mode 100644
index 0000000..cbcf4be
--- /dev/null
+++ b/dashboard/money/commands.mjs
@@ -0,0 +1,256 @@
+// money space — renderer intents → Ember reducer actions.
+// The renderer is untrusted input: it sends INTENTS ("log 1200 DA to cash"), never entities.
+// Ids and timestamps are minted here, every field is re-validated, and the result still goes
+// through the ported slice reducers + sanitizeState — so a forged intent can at worst be refused.
+// apply() throws MoneyError with owner-facing copy; anything else is a bug.
+import { moneyReducer, withPayment } from './state.mjs';
+import { inboxReducer, planAdd } from './inbox.mjs';
+import { obligationViews, toDA } from './engine.mjs';
+import { parseAmount, parseMany, INBOX_CATEGORIES } from './parse.mjs';
+import { localDayISO, isValidDayKey } from './dates.mjs';
+import { alreadyLogged } from './dedupe.mjs';
+import { sanitizeState } from './store.mjs';
+
+export class MoneyError extends Error {}
+const fail = (msg) => { throw new MoneyError(msg); };
+
+export const INTENTS = ['account-save', 'account-archive', 'settings', 'log', 'tx-undo', 'obligation-save', 'obligation-archive', 'obligation-pay', 'obligation-unpay', 'jar-save', 'jar-archive', 'jar-move', 'jar-cover', 'split-save', 'payday-run', 'inbox-paste', 'inbox-confirm', 'inbox-reject', 'inbox-clear'];
+export const CATEGORIES = [...INBOX_CATEGORIES];
+const KINDS = ['bill', 'variable', 'subscription', 'installment'], CADENCES = ['monthly', 'weekly', 'yearly', 'once'];
+const MAX_PASTE = 20000;
+
+// ---- field readers: strings from inputs, numbers from anywhere, all bounded --------------------
+const text = (v, max, what) => { const s = typeof v === 'string' ? v.trim() : ''; if (!s) fail(`${what} is empty.`); return s.slice(0, max); };
+const optText = (v, max) => (typeof v === 'string' ? v.trim().slice(0, max) : '');
+// "2 500", "1.200,00", "12.49" all read like the parser reads receipts; > 0 and under a billion
+function amount(v, what = 'amount') {
+  const n = typeof v === 'number' ? v : typeof v === 'string' ? parseAmount(v.trim()) : null;
+  if (n === null || !Number.isFinite(n) || n <= 0 || n >= 1e9) fail(`${what} needs a number above 0.`);
+  return Math.round(n * 100) / 100;
+}
+const optAmount = (v, what) => (v === undefined || v === null || v === '' ? null : amount(v, what));
+const currency = (v) => (v === 'USD' ? 'USD' : v === 'DA' || v === undefined ? 'DA' : fail('currency is DA or USD.'));
+const day = (v, what) => (isValidDayKey(v) ? v : fail(`${what} needs a date (yyyy-mm-dd).`));
+const id = (v) => (typeof v === 'string' && /^[\w:.-]{1,80}$/.test(v) ? v : fail('that item is gone — reload and try again.'));
+
+function liveAccount(state, accountId) {
+  if (!accountId) return null;
+  const a = state.money.accounts.find((x) => x.id === accountId && !x.archived);
+  return a || fail('that account is gone — pick another.');
+}
+// a reducer that hands back the same object refused the input (its own sanitizer said no)
+function must(next, prev, msg) { if (next === prev) fail(msg); return next; }
+
+/**
+ * @param state  sanitized state (store.mjs)
+ * @param intent { type, ...fields } straight from the renderer
+ * @param env    { now: Date, newId: () => string } — injected so tests are deterministic
+ * @returns { state, note } note = owner-facing summary for the toast
+ */
+export function apply(state, intent, env) {
+  if (!intent || typeof intent !== 'object' || !INTENTS.includes(intent.type)) fail('unknown action.');
+  const now = env.now, nowISO = now.toISOString(), today = localDayISO(now), newId = env.newId;
+  const s = state, m = s.money, x = intent;
+  const withMoney = (money) => ({ ...s, money });
+  let next, note = '';
+  switch (x.type) {
+    case 'account-save': {
+      // new account, rename, or "confirm balance" — all re-anchor at now: the typed balance is the truth from here on
+      const prev = x.id ? m.accounts.find((a) => a.id === id(x.id)) : null;
+      if (x.id && !prev) fail('that account is gone — reload and try again.');
+      const balance = typeof x.balance === 'string' && x.balance.trim() === '0' ? 0 : amount(x.balance, 'balance');
+      const account = { id: prev ? prev.id : newId(), name: text(x.name ?? prev?.name, 40, 'name'), currency: prev ? prev.currency : currency(x.currency), anchorBalance: balance, anchorAt: nowISO, archived: false, updatedAt: nowISO };
+      next = withMoney(must(moneyReducer(m, { type: 'money/account-upsert', account }), m, 'that account could not be saved.'));
+      note = prev ? `${account.name} confirmed` : `${account.name} added`;
+      break;
+    }
+    case 'account-archive': {
+      const a = liveAccount(s, id(x.id));
+      next = withMoney(moneyReducer(m, { type: 'money/account-upsert', account: { ...a, archived: true, updatedAt: nowISO } }));
+      note = `${a.name} archived`;
+      break;
+    }
+    case 'settings': {
+      const fx = optAmount(x.fxDaPerUsd, 'rate');
+      const pd = x.paydayDay === '' || x.paydayDay == null ? null : Number(x.paydayDay);
+      if (pd !== null && !(Number.isInteger(pd) && pd >= 1 && pd <= 28)) fail('payday is a day from 1 to 28.');
+      next = withMoney(moneyReducer(m, { type: 'money/settings', settings: { fxDaPerUsd: fx, paydayDay: pd, split: m.settings.split }, nowISO }));
+      note = 'settings saved';
+      break;
+    }
+    case 'log': {
+      const cur = currency(x.currency), amt = amount(x.amount), acc = liveAccount(s, x.accountId);
+      const amountDA = toDA(amt, cur, m.settings.fxDaPerUsd);
+      if (amountDA === null) fail('set your DA rate first — this one is in USD.');
+      const category = CATEGORIES.includes(x.category) ? x.category : 'Other';
+      const tx = { id: newId(), amountDA, category, date: today, at: nowISO };
+      const n = optText(x.note, 200); if (n) tx.note = n;
+      if (acc) tx.accountId = acc.id;
+      if (cur === 'USD') tx.original = { amount: amt, currency: 'USD' };
+      next = { ...s, transactions: [tx, ...s.transactions] };
+      note = `logged · ${category}`;
+      break;
+    }
+    case 'tx-undo': {
+      const t = s.transactions.find((r) => r.id === id(x.id)) || fail('that entry is already gone.');
+      // a bill payment is undone from the runway, so its payment record goes with it
+      if (t.obligationId) fail('undo this one from the runway — it is a bill payment.');
+      next = { ...s, transactions: s.transactions.filter((r) => r.id !== t.id) };
+      note = 'entry removed';
+      break;
+    }
+    case 'obligation-save': {
+      const prev = x.id ? m.obligations.find((o) => o.id === id(x.id)) : null;
+      if (x.id && !prev) fail('that bill is gone — reload and try again.');
+      const kind = KINDS.includes(x.kind) ? x.kind : 'bill', cadence = CADENCES.includes(x.cadence) ? x.cadence : 'monthly';
+      let installment = null;
+      if (kind === 'installment') {
+        const total = Number(x.installmentTotal), paidBefore = Number(x.paidBefore || 0);
+        if (!(Number.isInteger(total) && total >= 2 && total <= 360)) fail('installments: how many payments in all (2–360)?');
+        if (!(Number.isInteger(paidBefore) && paidBefore >= 0 && paidBefore < total)) fail('already paid must be less than the total.');
+        installment = { total, paidBefore };
+      }
+      const acc = liveAccount(s, x.accountId);
+      const obligation = { id: prev ? prev.id : newId(), name: text(x.name, 40, 'name'), amount: amount(x.amount), currency: currency(x.currency), kind, cadence: kind === 'installment' ? 'monthly' : cadence, firstDue: day(x.firstDue, 'first due'), accountId: acc ? acc.id : null, installment, nextStep: optText(x.nextStep, 80), archived: false, updatedAt: nowISO };
+      next = withMoney(must(moneyReducer(m, { type: 'money/obligation-upsert', obligation }), m, 'that bill could not be saved.'));
+      note = prev ? `saved ${obligation.name}` : `${obligation.name} is on the runway`;
+      break;
+    }
+    case 'obligation-archive': {
+      const o = m.obligations.find((r) => r.id === id(x.id) && !r.archived) || fail('that bill is gone.');
+      next = withMoney(moneyReducer(m, { type: 'money/obligation-upsert', obligation: { ...o, archived: true, updatedAt: nowISO } }));
+      note = `${o.name} archived`;
+      break;
+    }
+    case 'obligation-pay': {
+      // pays the next unpaid cycle: a Bills ledger row + a payment record linked to it (Ember's OBLIGATION_PAY)
+      const v = obligationViews(m, today).find((r) => r.obligation.id === id(x.id)) || fail('that bill is gone.');
+      if (v.nextDue === null) fail(`${v.obligation.name} is already fully paid.`);
+      const ob = v.obligation, amt = x.amount === undefined || x.amount === '' ? v.estimate : amount(x.amount);
+      const amountDA = toDA(amt, ob.currency, m.settings.fxDaPerUsd);
+      if (amountDA === null) fail('set your DA rate first — this bill is in USD.');
+      const acc = liveAccount(s, x.accountId || ob.accountId), txId = newId();   // '' (no pick) falls back to the bill's own account
+      const tx = { id: txId, amountDA, category: 'Bills', note: ob.name, date: today, at: nowISO, obligationId: ob.id };
+      if (acc) tx.accountId = acc.id;
+      if (ob.currency === 'USD') tx.original = { amount: amt, currency: 'USD' };
+      const payment = { id: newId(), obligationId: ob.id, due: v.nextDue, paidOn: today, amount: amt, currency: ob.currency, txId, void: false, updatedAt: nowISO };
+      const money = must(withPayment(m, payment), m, 'that payment could not be recorded.');
+      next = { ...s, money, transactions: [tx, ...s.transactions] };
+      note = `${ob.name} paid`;
+      break;
+    }
+    case 'obligation-unpay': {
+      const p = m.payments.find((r) => r.id === id(x.paymentId) && !r.void) || fail('that payment is already undone.');
+      const money = moneyReducer(m, { type: 'money/payment-void', id: p.id, nowISO });
+      next = { ...s, money, transactions: s.transactions.filter((t) => t.id !== p.txId) };
+      note = 'payment undone';
+      break;
+    }
+    case 'jar-save': {
+      const prev = x.id ? m.jars.find((j) => j.id === id(x.id)) : null;
+      if (x.id && !prev) fail('that jar is gone — reload and try again.');
+      const target = optAmount(x.target, 'target');
+      const targetDate = x.targetDate ? day(x.targetDate, 'target date') : null;
+      if (targetDate && target === null) fail('a target date needs a target amount.');
+      const jar = { id: prev ? prev.id : newId(), name: text(x.name, 40, 'name'), emoji: prev ? prev.emoji : '', target, targetDate, locked: prev ? prev.locked : false, archived: false, updatedAt: nowISO };
+      next = withMoney(must(moneyReducer(m, { type: 'money/jar-upsert', jar }), m, 'that jar could not be saved.'));
+      note = prev ? `saved ${jar.name}` : `${jar.name} jar added`;
+      break;
+    }
+    case 'jar-archive': {
+      const j = m.jars.find((r) => r.id === id(x.id) && !r.archived) || fail('that jar is gone.');
+      next = withMoney(moneyReducer(m, { type: 'money/jar-upsert', jar: { ...j, archived: true, updatedAt: nowISO } }));
+      note = `${j.name} archived`;
+      break;
+    }
+    case 'jar-move': {
+      const j = m.jars.find((r) => r.id === id(x.jarId) && !r.archived) || fail('that jar is gone.');
+      const amt = amount(x.amount), out = x.kind === 'withdraw';
+      next = withMoney(must(moneyReducer(m, { type: 'money/jar-move', move: { id: newId(), jarId: j.id, amount: out ? -amt : amt, date: today, kind: out ? 'withdraw' : 'topup' } }), m, 'that move could not be saved.'));
+      note = out ? `took from ${j.name}` : `added to ${j.name}`;
+      break;
+    }
+    case 'jar-cover': {
+      // overspent jar → cover it from another: two moves sharing one id pair (Ember's coverMoves)
+      const from = m.jars.find((r) => r.id === id(x.fromJarId) && !r.archived) || fail('pick a jar to cover from.');
+      const to = m.jars.find((r) => r.id === id(x.toJarId) && !r.archived) || fail('that jar is gone.');
+      if (from.id === to.id) fail('pick a different jar to cover from.');
+      const amt = amount(x.amount), pair = newId();
+      next = withMoney(moneyReducer(m, { type: 'money/jar-moves', moves: [{ id: `cover:${pair}:out`, jarId: from.id, amount: -amt, date: today, kind: 'cover' }, { id: `cover:${pair}:in`, jarId: to.id, amount: amt, date: today, kind: 'cover' }] }));
+      note = `${to.name} covered from ${from.name}`;
+      break;
+    }
+    case 'split-save': {
+      const live = new Set(m.jars.filter((j) => !j.archived).map((j) => j.id));
+      const rows = (Array.isArray(x.rows) ? x.rows : []).slice(0, 50).map((r) => ({ jarId: id(r && r.jarId), amount: r && r.amount !== '' && r.amount != null ? amount(r.amount) : 0 })).filter((r) => r.amount > 0 && live.has(r.jarId));
+      next = withMoney(moneyReducer(m, { type: 'money/settings', settings: { fxDaPerUsd: m.settings.fxDaPerUsd, paydayDay: m.settings.paydayDay, split: rows }, nowISO }));
+      note = 'payday split saved';
+      break;
+    }
+    case 'payday-run': {
+      // income lands on one account, then the saved split replays into jars (Ember's PaydayCard)
+      const acc = liveAccount(s, x.accountId) || fail('pick the account the pay landed in.');
+      const amt = amount(x.amount), incomeId = newId();
+      const live = new Set(m.jars.filter((j) => !j.archived).map((j) => j.id));
+      const split = m.settings.split.filter((r) => live.has(r.jarId) && r.amount > 0);
+      let money = must(moneyReducer(m, { type: 'money/income-add', income: { id: incomeId, accountId: acc.id, amount: amt, date: today, at: nowISO, note: 'payday' } }), m, 'that income could not be saved.');
+      if (split.length) money = moneyReducer(money, { type: 'money/jar-moves', moves: split.map((r) => ({ id: `payday:${incomeId}:${r.jarId}`, jarId: r.jarId, amount: r.amount, date: today, kind: 'payday' })) });
+      next = withMoney(money);
+      note = split.length ? `payday in · split into ${split.length} jar${split.length === 1 ? '' : 's'}` : 'payday in';
+      break;
+    }
+    case 'inbox-paste': {
+      const raw = typeof x.text === 'string' ? x.text : '';
+      if (!raw.trim()) fail('paste something first — a receipt, an email or an sms.');
+      if (raw.length > MAX_PASTE) fail('that is too long to read at once — paste a few messages at a time.');
+      const { candidates, messages } = parseMany(raw, { from: optText(x.from, 80), receivedAt: nowISO });
+      if (!candidates.length) fail('no DA or USD amount found in that. nothing was saved.');
+      const rows = candidates.map((c) => ({ ...c, id: newId(), status: 'pending', txId: null, cleared: false, updatedAt: nowISO }));
+      const plan = planAdd(s.inbox, rows, nowISO);
+      next = { ...s, inbox: plan.state };
+      const parts = [`read ${messages} message${messages === 1 ? '' : 's'}`];
+      if (plan.added) parts.push(`${plan.added} slip${plan.added === 1 ? '' : 's'} to review`);
+      if (plan.merged) parts.push(`${plan.merged} matched a slip already here`);
+      if (messages > candidates.length) parts.push(`${messages - candidates.length} had no amount`);
+      note = parts.join(' · ');
+      break;
+    }
+    case 'inbox-confirm': {
+      const c = s.inbox.candidates.find((r) => r.id === id(x.id) && r.status === 'pending' && !r.cleared) || fail('that slip is already handled.');
+      if (c.flags.includes('refund')) {
+        // a refund is money coming back: income on a same-currency account, never spending
+        const acc = x.accountId ? liveAccount(s, x.accountId) : null;
+        if (acc && acc.currency !== c.currency) fail(`a ${c.currency} refund goes back to a ${c.currency} account.`);
+        let money = m;
+        if (acc) money = moneyReducer(m, { type: 'money/income-add', income: { id: newId(), accountId: acc.id, amount: Math.abs(c.amount), date: c.date, at: nowISO, note: `refund · ${c.merchant}`.slice(0, 120) } });
+        next = { ...s, money, inbox: inboxReducer(s.inbox, { type: 'inbox/resolve', id: c.id, status: 'confirmed', txId: null, nowISO }) };
+        note = acc ? `refund back on ${acc.name}` : 'refund noted';
+        break;
+      }
+      // promos, renewal notices and already-logged purchases need a deliberate second tap — enforced here, not only in the UI
+      const logged = alreadyLogged(c, s.transactions, m.settings.fxDaPerUsd);
+      if ((c.flags.includes('promo') || c.flags.includes('not_a_charge') || logged) && x.anyway !== true) fail('this one looks like it should not be logged — tap confirm anyway if it should.');
+      const amountDA = c.amount === 0 ? 0 : toDA(c.amount, c.currency, m.settings.fxDaPerUsd);
+      if (amountDA === null) fail('set your DA rate first — this one is in USD.');
+      const acc = liveAccount(s, x.accountId);
+      const tx = { id: newId(), amountDA, category: CATEGORIES.includes(x.category) ? x.category : c.suggestedCategory, note: 'from inbox', date: c.date, at: nowISO };
+      if (acc) tx.accountId = acc.id;
+      if (c.currency === 'USD') tx.original = { amount: c.amount, currency: 'USD' };
+      next = { ...s, transactions: [tx, ...s.transactions], inbox: inboxReducer(s.inbox, { type: 'inbox/resolve', id: c.id, status: 'confirmed', txId: tx.id, nowISO }) };
+      note = `${c.merchant} logged`;
+      break;
+    }
+    case 'inbox-reject': {
+      const c = s.inbox.candidates.find((r) => r.id === id(x.id) && r.status === 'pending') || fail('that slip is already handled.');
+      next = { ...s, inbox: inboxReducer(s.inbox, { type: 'inbox/resolve', id: c.id, status: 'rejected', txId: null, nowISO }) };
+      note = 'slip set aside';
+      break;
+    }
+    case 'inbox-clear': {
+      next = { ...s, inbox: must(inboxReducer(s.inbox, { type: 'inbox/clear-resolved', nowISO }), s.inbox, 'nothing handled to clear.') };
+      note = 'handled slips cleared';
+      break;
+    }
+  }
+  return { state: sanitizeState(next), note };
+}
diff --git a/dashboard/money/dates.mjs b/dashboard/money/dates.mjs
