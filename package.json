{
  "name": "ember",
  "private": true,
  "version": "0.1.0",
  "description": "Ember — a money app that runs on your phone, not on your bank. Local-first, manual logging in DA, no account and no bank link.",
  "keywords": [
    "budgeting",
    "personal-finance",
    "local-first",
    "offline-first",
    "algeria",
    "react",
    "typescript"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Brvetr4ve1er/money-manager-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brvetr4ve1er/money-manager-.git"
  },
  "bugs": {
    "url": "https://github.com/Brvetr4ve1er/money-manager-/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node --experimental-strip-types scripts/brand-assets.ts",
    "census": "node --experimental-strip-types scripts/census/run.ts",
    "census:diff": "node --experimental-strip-types scripts/census/run.ts --diff"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
